# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_USER=cable_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cable_payment_system
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://cable_admin:change_me@localhost:5432/cable_payment_system

# --- Auth ---
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ---
ENV=development

# --- Notifications ---
# Leave blank to run SMS in simulated mode (no real sending, still logged in history).
# Sign up at https://www.fast2sms.com for a free trial key to send real SMS.
FAST2SMS_API_KEY=
# Base URL customers' payment links point to (the frontend dev server, or your deployed domain).
# Used directly when running the backend bare-metal (uvicorn). When running the FULL STACK via
# docker-compose.yml, this is overridden there -- set DEPLOYED_BASE_URL instead (see below).
FRONTEND_BASE_URL=http://localhost:5173

# --- Full-stack Docker deployment only (docker-compose.yml) ---
# Public URL the whole app (frontend + API, served together via Nginx) is reachable at.
# Leave unset for local Docker use (defaults to http://localhost:8080). Set this to your real
# domain (e.g. https://cable.example.com) once you deploy to a VPS.
DEPLOYED_BASE_URL=
